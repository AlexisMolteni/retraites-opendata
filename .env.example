# API publique — aucune clé requise
BASE_URL=https://data.assuranceretraite.fr/api/explore/v2.1/catalog/datasets

# Répertoires de données (chemins relatifs au projet)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Jupyter (optionnel, pour scripts de lancement)
JUPYTER_PORT=8888
JUPYTER_IP=0.0.0.0

# ── Azure Key Vault ───────────────────────────────────────────
AZURE_KEYVAULT_URL=https://sifa-vault1.vault.azure.net/

# Service Principal (laisser vide pour utiliser Az PowerShell / Managed Identity)
# AZURE_TENANT_ID=90b590b6-5ccc-471c-a0b0-8ee1389e07c7
# AZURE_CLIENT_ID=<app-id-du-service-principal>
# AZURE_CLIENT_SECRET=<secret-du-service-principal>

# ── SQL Server ────────────────────────────────────────────────
SQL_SERVER=localhost\MSSQLSERVER2022
SQL_DATABASE=RetraitesOpenData
SQL_USER=sa
SQL_SECRET_NAME=SQL-SACredential
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
